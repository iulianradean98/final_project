aws_region = "eu-central-1"

project_name = "recipe-rescue"
environment  = "shared"
owner        = "iulian"

vpc_cidr = "10.40.0.0/16"
az_count = 2

# Cost-aware default for a student project: no NAT Gateway.
# Worker nodes use public subnets, while AWS security groups still control access.
enable_nat_gateway = false
single_nat_gateway = true
use_private_nodes  = false

kubernetes_version = "1.33"

node_instance_types = ["t3.small"]
node_capacity_type  = "ON_DEMAND"
node_min_size       = 1
node_desired_size   = 1
node_max_size       = 2
