aws_region = "eu-central-1"

project_name = "recipe-rescue"
environment  = "shared"
owner        = "iulian"

vpc_cidr = "10.40.0.0/16"
az_count = 2

# Professional demo default: private worker nodes with one NAT Gateway.
# This costs more than public worker nodes, but it is the cleaner production-style design.
enable_nat_gateway = true
single_nat_gateway = true
use_private_nodes  = true

kubernetes_version = "1.36"

# Optional local cluster admins. Set this in your real terraform.tfvars or through
# TF_VAR_eks_admin_principal_arns in GitHub Actions.
eks_admin_principal_arns = []

node_instance_types = ["t3.small"]
node_capacity_type  = "ON_DEMAND"
node_min_size       = 2
node_desired_size   = 6
node_max_size       = 7

argocd_chart_version            = "10.1.3"
argo_rollouts_chart_version     = "2.41.0"
external_secrets_chart_version  = "2.7.0"

# Existing S3 bucket used by Kubernetes PostgreSQL backup CronJobs.
# Create it once outside this destroyable EKS stack.
db_backup_s3_bucket_name = "recipe-rescue-db-backups-iulian-2026"
db_backup_s3_prefix      = "recipe-rescue"
