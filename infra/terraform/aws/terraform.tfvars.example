aws_region = "eu-central-1"

project_name = "recipe-rescue"
environment  = "shared"
owner        = "iulian"

vpc_cidr = "10.40.0.0/16"
az_count = 2

# Professional demo default: private worker nodes with one NAT Gateway.
# This costs more than public worker nodes, but it is the cleaner production-style design.
enable_nat_gateway = true
single_nat_gateway = true
use_private_nodes  = true

kubernetes_version = "1.33"

node_instance_types = ["t3.small"]
node_capacity_type  = "ON_DEMAND"
node_min_size       = 2
node_desired_size   = 4
node_max_size       = 4
