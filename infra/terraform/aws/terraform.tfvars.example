aws_region = "eu-central-1"

project_name = "recipe-rescue"
environment  = "shared"
owner        = "iulian"

vpc_cidr = "10.40.0.0/16"
az_count = 2

# Cost-aware default for a student project: one NAT Gateway instead of one per AZ.
single_nat_gateway = true

kubernetes_version = "1.33"

node_instance_types = ["t3.small"]
node_min_size       = 1
node_desired_size   = 2
node_max_size       = 3
